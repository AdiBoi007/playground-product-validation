# Public browser settings. Leave BOTH empty to use the local rehearsal workspace.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only. Never prefix these secrets with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
APP_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Required for the Sandbox chatbot and automatic web research.
# Set in .env for development, or server environment variables on Vercel.
# These values must never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
SANDBOX_MODEL=gpt-6-luna
AI_DAILY_REQUEST_LIMIT=50
AI_DAILY_USER_REQUEST_LIMIT=10

# Browser worker: npm run dev generates a private local secret when empty.
# Set the same secret in Vercel and the separately hosted worker.
TWIN_WORKER_URL=http://127.0.0.1:8787
TWIN_WORKER_SECRET=
TWIN_PORT=8787
TWIN_HOST=127.0.0.1
TWIN_DATA_DIR=
# Leave blank for bundled Chromium; `chrome` uses installed Google Chrome.
TWIN_CHROME_CHANNEL=
TWIN_MAX_CONCURRENCY=2
TWIN_MAX_JOBS_PER_WORKSPACE_HOUR=6
TWIN_DAILY_MODEL_BUDGET_USD=2
# Explicit staging write endpoints only, e.g. {"https://staging.example.com":["/api/test-projects"]}
TWIN_SAFE_WRITE_PATHS={}
# Durable hosted storage; local files are available for local/pilot use.
TWIN_DATABASE_URL=
TWIN_DATABASE_SSL=true
TWIN_S3_BUCKET=
TWIN_S3_REGION=us-east-1
TWIN_S3_ENDPOINT=
TWIN_S3_FORCE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
